# ─────────────────────────────────────────────────────────────────────────────
#  Example environment. Copy to `.env` and fill in.
#
#  Every value here is a PLACEHOLDER. Nothing in this file is a recommended or
#  deployed setting — it names the surface, it does not tune it.
#
#  This is the MAKER surface only. Market selection, sizing and cadence are
#  supplied at runtime from a registry file (see config/probe.example.json)
#  and on the command line; they are not environment variables.
#
#  As written this file arms nothing: DRY_RUN=true, and the real-money flag
#  exists only on the command line.
# ─────────────────────────────────────────────────────────────────────────────

# ── Posture ──────────────────────────────────────────────────────────────────
# The master safety flag. Leave it true unless you are deliberately arming.
# The maker shims additionally require an explicit --i-understand-real-money
# flag, so flipping this alone does not place an order.
DRY_RUN=true
LOG_LEVEL=INFO

# Operator kill switch. Creating this file halts quoting at the top of the
# next cycle and runs the full teardown (cancel → reconcile → flatten → sweep).
# NOTE it is relative by default, so it resolves against the cwd of the
# process you want to halt — not yours.
KILL_SWITCH_FILE=pause.json

# Optional outer loss bounds, in account currency. OFF by default in
# bot/core/config.py (0); set a positive value to enable. These are optional
# checks, distinct from the fail-closed placeholder constants described in
# README.md § Limitations. The maker's own durable loss-cap ratchet
# (bot/core/maker_state.py) is the primary protection and is always on.
# DAILY_LOSS_LIMIT=25
# KALSHI_EXEC_COST_BUDGET=5

# ── Polymarket US credentials ────────────────────────────────────────────────
POLYMARKET_US_KEY_ID=your-key-id
POLYMARKET_US_SECRET_KEY=your-secret-key

# Live price feed transport: "raw" (our own websocket client — explicit
# ping/pong and heartbeat-stop reconnect) or "sdk" (vendor SDK socket).
POLY_US_FEED_SOURCE=raw

# The maker's per-cycle book read source: "rest" (one cache-busted fetch per
# book per cycle) or "ws" (read the maintained order-book cache, gated on
# content freshness, with a single-book REST backstop).
MAKER_BOOK_SOURCE=rest

# ── Kalshi credentials ───────────────────────────────────────────────────────
KALSHI_API_KEY=your-api-key-id
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem
# "demo" or "prod". Defaults to demo: a forgotten variable must land on the
# harmless side.
KALSHI_ENV=demo

# Comma-separated series prefixes. This is a HARD filter on inbound websocket
# messages — a market outside this set is invisible to the feed regardless of
# what you point the maker at. Placeholder value; choose your own.
KALSHI_SERIES=EXAMPLESERIES

# "ticker" (top-of-book quote channel; can lag the real book) or "orderbook"
# (the executable book, maintained from delta messages).
KALSHI_PRICE_SOURCE=ticker

# ── Websocket receive-loop timing diagnostics (off by default) ───────────────
WS_LOOP_TIMING=false

# ── Notifications (optional; unset = silent) ─────────────────────────────────
# One webhook. Delivery outcomes are recorded locally (bot/core/alert_health.py)
# because a dead webhook cannot report its own death.
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_DRY_RUN=false
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# ── Operational rails (optional overrides) ───────────────────────────────────
# Unset is preferred: the defaults are ABSOLUTE paths under the repo root. A
# relative operational path silently reads a different file when the process is
# launched from another directory, and a loss cap reading an empty ledger is a
# loss cap that never fires.
# ALERT_HEALTH_FILE=
# HEARTBEAT_DIR=
# MAKER_STATE_FILE=

# ── Memory guard (MB; 0 disables an individual check) ────────────────────────
# Enabled by default with the thresholds in bot/core/config.py (warn 400 MB RSS,
# halt 700 MB RSS, 256 MB free). Size them to the host: the point is to halt
# cleanly before the OS out-of-memory killer sends a SIGKILL that runs no
# teardown. 0 on an individual threshold disables that one check.
MEMGUARD_ENABLED=true
# MEMGUARD_WARN_RSS_MB=400
# MEMGUARD_HALT_RSS_MB=700
# MEMGUARD_MIN_AVAIL_MB=256
